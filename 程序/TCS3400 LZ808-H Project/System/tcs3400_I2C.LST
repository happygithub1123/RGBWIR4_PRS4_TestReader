  55          /*------------------------------------------------
  56           * @brief 等待从机应答（ACK）
  57           * @return 0：收到 ACK
  58           *         1：未收到 ACK（NACK）
  59           * 
  60           * 说明：
  61           *  - 主机释放 TCS3400_SDA
  62           *  - 从机在 TCS3400_SCL 高电平期间拉低 TCS3400_SDA 表示 ACK
  63           *------------------------------------------------*/
  64          bit TCS3400_I2C_WaitAck(void)
  65          {
  66   1          TCS3400_SDA = 1;              /* 释放 TCS3400_SDA，由从机控制 */
  67   1          TCS3400_I2C_DelayN(TCS3400_T_HD_DAT);
  68   1      
  69   1          TCS3400_SCL = 1;              /* 拉高 TCS3400_SCL，检测 ACK */
  70   1          TCS3400_I2C_DelayN(TCS3400_T_HIGH);
  71   1      
  72   1          if (TCS3400_SDA)              /* TCS3400_SDA 为高，表示 NACK */
  73   1          {
  74   2              TCS3400_SCL = 0;
  75   2              TCS3400_I2C_DelayN(TCS3400_T_LOW);
  76   2              return 1;
  77   2          }
  78   1      
  79   1          TCS3400_SCL = 0;              /* TCS3400_SDA 为低，表示 ACK */
  80   1          TCS3400_I2C_DelayN(TCS3400_T_LOW);
  81   1          return 0;
  82   1      }
