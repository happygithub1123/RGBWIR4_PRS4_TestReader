 144          /*------------------------------------------------
 145           * @brief I2C 读取 1 个字节
 146           * @return 接收到的数据
 147           *------------------------------------------------*/
 148          unsigned char TCS3400_I2C_ReadByte(void)
 149          {
 150   1          unsigned char i, dat = 0;
 151   1      
 152   1          TCS3400_SDA = 1;                 /* 释放 TCS3400_SDA，由从机驱动 */
 153   1      
 154   1          for (i = 0; i < 8; i++)
 155   1          {
 156   2              TCS3400_SCL = 0;             /* TCS3400_SCL 低电平准备 */
 157   2              TCS3400_I2C_DelayN(TCS3400_T_LOW);
 158   2      
 159   2              TCS3400_SCL = 1;             /* TCS3400_SCL 高电平读取数据 */
 160   2              TCS3400_I2C_DelayN(TCS3400_T_HIGH/2);
 161   2      
 162   2              dat <<= 1;           /* MSB first */
 163   2              if (TCS3400_SDA) dat |= 0x01;/* 读取 TCS3400_SDA 电平 */
 164   2      
 165   2              TCS3400_I2C_DelayN(TCS3400_T_HIGH - TCS3400_T_HIGH/2);
 166   2          }
 167   1      
 168   1          TCS3400_SCL = 0;                 /* 最后拉低 TCS3400_SCL */
 169   1          TCS3400_I2C_DelayN(TCS3400_T_LOW);
 170   1      
 171   1          return dat;
 172   1      }
