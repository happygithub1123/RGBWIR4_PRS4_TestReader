 120          /*------------------------------------------------
 121           * @brief I2C 发送 1 个字节
 122           * @param dat 要发送的数据
 123           *------------------------------------------------*/
 124          void TCS3400_I2C_SendByte(unsigned char dat)
 125          {
 126   1          unsigned char i;
 127   1      
 128   1          for (i = 0; i < 8; i++)
 129   1          {
 130   2              /* 发送高位在前 MSB first */
 131   2              TCS3400_SDA = (dat & 0x80) ? 1 : 0;
 132   2              TCS3400_I2C_DelayN(TCS3400_T_SU_DAT);      /* 数据建立时间 tSU;DAT */
 133   2      
 134   2              TCS3400_SCL = 1;          /* TCS3400_SCL 上升沿，数据被采样 */
 135   2              TCS3400_I2C_DelayN(TCS3400_T_HIGH);       /* 时钟高电平时间 tHIGH */
 136   2      
 137   2              TCS3400_SCL = 0;          /* TCS3400_SCL 下降沿 */
 138   2              TCS3400_I2C_DelayN(TCS3400_T_LOW);      /* 时钟低电平时间 tLOW */
 139   2      
 140   2              dat <<= 1;        /* 移位，准备下一位 */
 141   2          }
 142   1      }
