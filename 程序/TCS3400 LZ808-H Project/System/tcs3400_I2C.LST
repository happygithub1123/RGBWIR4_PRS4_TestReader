  94   1      
  95   1          TCS3400_SCL = 1;              /* 时钟脉冲 */
  96   1          TCS3400_I2C_DelayN(TCS3400_T_HIGH);
  97   1      
  98   1          TCS3400_SCL = 0;
  99   1          TCS3400_I2C_DelayN(TCS3400_T_LOW);
 100   1      }
