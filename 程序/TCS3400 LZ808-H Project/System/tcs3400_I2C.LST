  19          /*------------------------------------------------
  20           * @brief 产生 I2C 起始信号（START）
  21           * 
  22           * 时序说明：
  23           *  - TCS3400_SCL 为高电平时，TCS3400_SDA 由高变低
  24           *------------------------------------------------*/
  25          void TCS3400_I2C_Start(void)
  26          {
  27   1          TCS3400_SDA = 1;              /* 释放 TCS3400_SDA */
  28   1          TCS3400_SCL = 1;              /* TCS3400_SCL 置高 */
  29   1          TCS3400_I2C_DelayN(TCS3400_T_SU_STA); /* 起始建立时间 tSU;STA */
  30   1      
  31   1          TCS3400_SDA = 0;              /* TCS3400_SDA 下降沿，产生 START */
  32   1          TCS3400_I2C_DelayN(TCS3400_T_HD_STA); /* 起始保持时间 tHD;STA */
  33   1      
  34   1          TCS3400_SCL = 0;              /* 拉低 TCS3400_SCL，准备发送数据 */
  35   1      }
