  40           * 时序说明：
  41           *  - TCS3400_SCL 为高电平时，TCS3400_SDA 由低变高
  42           *------------------------------------------------*/
  43          void TCS3400_I2C_Stop(void)
  44          {
  45   1          TCS3400_SDA = 0;              /* 确保 TCS3400_SDA 为低 */
