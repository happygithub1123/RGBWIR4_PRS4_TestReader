 142          void Uart_PrintHex8(unsigned char dat)
 143          {
 144   1          unsigned char hi;
 145   1          unsigned char lo;
 146   1          char c;
 147   1      
 148   1          hi = (dat >> 4) & 0x0F;
 149   1          lo = dat & 0x0F;
 150   1      
 151   1          c = (hi < 10) ? ('0' + hi) : ('A' + hi - 10);
 152   1          Uart_SendByte(c);
 153   1      
 154   1          c = (lo < 10) ? ('0' + lo) : ('A' + lo - 10);
 155   1          Uart_SendByte(c);
 156   1      }
