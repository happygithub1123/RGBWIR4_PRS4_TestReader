 118          void Uart_PrintUint16(unsigned int num)
 119          {
 120   1          char buf[6];
 121   1          char i;
 122   1      
 123   1          if (num == 0)
 124   1          {
 125   2              Uart_SendByte('0');
 126   2              return;
 127   2          }
 128   1      
 129   1          i = 0;
 130   1          while (num)
 131   1          {
 132   2              buf[i++] = (num % 10) + '0';
 133   2              num /= 10;
 134   2          }
 135   1      
 136   1          while (i--)
 137   1          {
 138   2              Uart_SendByte(buf[i]);
 139   2          }
 140   1      }
