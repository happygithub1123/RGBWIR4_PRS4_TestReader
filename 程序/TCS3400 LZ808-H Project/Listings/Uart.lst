  44   1          TMOD &= 0x0F;       // 设置Timer1模式
  45   1          TL1 = 0xD0;         // 115200bps @ 22.1184MHz
  46   1          TH1 = 0xFF;
  47   1          ET1 = 0;            // 禁止Timer1中断
  48   1          TR1 = 1;            // 启动Timer1
  49   1      
