 388           *   r=700 g=720  b=690 → 返回 0（白光）
 389           *------------------------------------------------*/
 390          static bit Is_Green(uint16 r, uint16 g, uint16 b)
 391          {
 392   1          return (g > r * COLOR_RATIO) && (g > b * COLOR_RATIO);
 393   1      }
