  57          /*------------------------------------------------
  58           * @brief TCS3400 初始化
  59           *
  60           * 推荐配置：
  61           *  ATIME = 100ms
  62           *  AGAIN = 4x
  63           *  ENABLE = PON + AEN
  64           *------------------------------------------------*/
  65          void TCS3400_Init(void)
  66          {
  67   1          /* 1) 上电 PON */
  68   1          TCS_Write8(TCS3400_ENABLE, TCS3400_EN_PON);
  69   1          Delay_ms(3);
  70   1      
  71   1          /* 2) 配置积分时间 + 增益 */
  72   1          TCS3400_SetATIME(TCS3400_CalcATIME(100));
  73   1          TCS3400_SetGain(TCS3400_GAIN_4X);
  74   1      
  75   1          /* 3) 不使用等待功能（WTIME/WEN 可选）
  76   1             如果你想加等待，可这样：
  77   1             TCS3400_SetWTIME(0xFF); // 2.78ms
  78   1             ENABLE = PON | AEN | WEN;
  79   1          */
  80   1      
  81   1          /* 4) 开启 RGBC 转换 AEN */
  82   1          TCS_Write8(TCS3400_ENABLE, TCS3400_EN_PON | TCS3400_EN_AEN);
  83   1      }
  84          
  85          
  86          /*------------------------------------------------
  87           * @brief 根据期望积分时间（ms）计算 ATIME（无浮点）
  88           *
  89           * 积分时间公式：
  90           *   T_int = (256 - ATIME) * 2.78ms
  91           *
  92           * 这里用整数近似：
  93           *   Cycles ≈ time_ms / 2.78
  94           *   Cycles ≈ (time_ms * 100) / 278
  95           *------------------------------------------------*/
  96          uint8 TCS3400_CalcATIME(uint16 time_ms)
  97          {
  98   1          uint16 xdata cycles;  // ← 加 xdata
  99   1      
 100   1          if (time_ms < 3)   time_ms = 3;
 101   1          if (time_ms > 700) time_ms = 700;
 102   1      
 103   1          /* cycles = time_ms / 2.78 */
 104   1          cycles = (time_ms * 100) / 278;
 105   1      
 106   1          if (cycles < 1)   cycles = 1;
 107   1          if (cycles > 256) cycles = 256;
 108   1      
 109   1          return (uint8)(256 - cycles);
 110   1      }
