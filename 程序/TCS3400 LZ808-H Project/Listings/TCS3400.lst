 346          /*------------------------------------------------
 347           * @brief 判断当前颜色是否为红色
 348           *
 349           * 判断原理：
 350           * 红色通道的数值明显大于绿色和蓝色通道，
 351           * 且至少是它们的 COLOR_RATIO 倍，
 352           * 用于排除亮度变化带来的误判。
 353           *
 354           * @param r  红色通道原始数据
 355           * @param g  绿色通道原始数据
 356           * @param b  蓝色通道原始数据
 357           *
 358           * @return 1：判断为红色
 359           *         0：非红色
 360           *
 361           * 示例：
 362           *   r=1600 g=300 b=280 → 返回 1（红色）
 363           *   r=900  g=850 b=800 → 返回 0（接近白色）
 364           *------------------------------------------------*/
C51 COMPILER V9.54   TCS3400                                                               01/29/2026 10:42:10 PAGE 7   

 365          static bit Is_Red(uint16 r, uint16 g, uint16 b)
 366          {
 367   1          return (r > g * COLOR_RATIO) && (r > b * COLOR_RATIO);
 368   1      }
 369          
 370          
 371          
 372          /*------------------------------------------------
 373           * @brief 判断当前颜色是否为绿色
 374           *
 375           * 判断原理：
 376           * 绿色通道能量明显高于红色和蓝色通道，
 377           * 并且达到 COLOR_RATIO 的比例关系。
 378           *
 379           * @param r  红色通道原始数据
 380           * @param g  绿色通道原始数据
 381           * @param b  蓝色通道原始数据
 382           *
 383           * @return 1：判断为绿色
 384           *         0：非绿色
 385           *
 386           * 示例：
