 149          /*------------------------------------------------
 150           * @brief 等待 TCS3400 数据有效（AVALID=1），带超时保护
 151           *
 152           * @param 无
 153           *
 154           * 示例：
 155           *   if (TCS3400_WaitValid()) { read RGBC  }
 156           *------------------------------------------------*/
 157           
 158          static bit TCS3400_WaitValid(void)
 159          {
 160   1          uint8 t = 100; // 超时计数
 161   1          while(t--)
 162   1          {
 163   2              if (TCS_Read8(TCS3400_STATUS) & TCS3400_STATUS_AVALID)
 164   2                  return 1;
 165   2              Delay_ms(3);
 166   2          }
 167   1          return 0;
 168   1      }
