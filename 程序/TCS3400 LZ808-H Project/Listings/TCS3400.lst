 422          /*------------------------------------------------
 423           * @brief TCS3400 颜色识别总接口（工程级）
 424           *
 425           * 颜色判断顺序（工程经验）：
 426           * 1. 黑色 / 暗场（亮度不足）
C51 COMPILER V9.54   TCS3400                                                               01/29/2026 10:42:10 PAGE 8   

 427           * 2. 红外光（IR 占比过高）
 428           * 3. 白色（RGB 均衡且亮度高）
 429           * 4. 彩色（红 / 绿 / 蓝）
 430           *
 431           * @param r   红色通道原始数据
 432           * @param g   绿色通道原始数据
 433           * @param b   蓝色通道原始数据
 434           * @param c   Clear 通道总光强
 435           
 436           *------------------------------------------------*/
 437          Color_t TCS3400_ColorDetect_RGB(uint16 r, uint16 g, uint16 b, uint16 c)
 438          {
 439   1          if (c < C_DARK_TH) return COLOR_BLACK;
 440   1      
 441   1          if (Is_Red(r, g, b))      return COLOR_RED;
 442   1          if (Is_Green(r, g, b))    return COLOR_GREEN;
 443   1          if (Is_Blue(r, g, b))     return COLOR_BLUE;
 444   1      
 445   1          return COLOR_UNKNOWN;
 446   1      }
 447          
 448          
 449          
 450          Color_t TCS3400_ColorDetect_WithWLED(uint16 r, uint16 g, uint16 b, uint16 c, uint16 ir)
 451          {
 452   1          if (c < C_DARK_TH) return COLOR_BLACK;
 453   1      
 454   1          /* ? 白色LED识别（不等于红外判断，只是识别白光LED） */
 455   1          if (Is_WhiteLED(r, g, b, c)) return COLOR_WLED;
 456   1      
 457   1          /* 其它颜色判断仍然只看RGB */
 458   1          if (Is_White(r, g, b, c)) return COLOR_WHITE;
 459   1          if (Is_Red(r, g, b))      return COLOR_RED;
 460   1          if (Is_Green(r, g, b))    return COLOR_GREEN;
 461   1          if (Is_Blue(r, g, b))     return COLOR_BLUE;
 462   1      
 463   1          return COLOR_UNKNOWN;
 464   1      }
