 295          /*------------------------------------------------
 296           * @brief 对外提供白色LED判断接口（给 main 用）
 297           *------------------------------------------------*/
 298          /* ================= 白色LED识别参数（可调） ================= */
 299          
 300          
 301          static bit TCS3400_IsWhiteLED(uint16 r, uint16 g, uint16 b, uint16 c)
 302          {
C51 COMPILER V9.54   TCS3400                                                               01/29/2026 10:42:10 PAGE 6   

 303   1          static bit wled_flag = 0;
 304   1      
 305   1          uint16 xdata maxv, minv;   // 加 xdata
 306   1          uint32 xdata sum;          // 加 xdata（最重要！）
 307   1          uint16 xdata avg;          // 加 xdata
 308   1          uint16 xdata ratio;        // 加 xdata
 309   1      
 310   1          /* 计算平均亮度（只看RGB，不被IR干扰） */
 311   1          sum = (uint32)r + (uint32)g + (uint32)b;
 312   1          avg = (uint16)(sum / 3);
 313   1      
 314   1          /* 找最大最小 */
 315   1          maxv = r;
 316   1          if (g > maxv) maxv = g;
 317   1          if (b > maxv) maxv = b;
 318   1      
 319   1          minv = r;
 320   1          if (g < minv) minv = g;
 321   1          if (b < minv) minv = b;
 322   1      
 323   1          if (minv == 0) minv = 1;
 324   1      
 325   1          /* max/min 比例（白光应该接近1，彩色会很大） */
 326   1          ratio = (uint16)(((uint32)maxv * 100) / minv);   // 100=1.00倍
 327   1      
 328   1          /* ================== 滞回判断 ================== */
 329   1          if (wled_flag == 0)
 330   1          {
 331   2              /* 进入白光LED条件（严格） */
 332   2              if (c > 1200 && avg > 800 && ratio < 150)     // <1.5倍
 333   2                  wled_flag = 1;
 334   2          }
 335   1          else
 336   1          {
 337   2              /* 退出白光LED条件（放松一点） */
 338   2              if (c < 900 || avg < 600 || ratio > 180)      // >1.8倍
 339   2                  wled_flag = 0;
 340   2          }
 341   1      
 342   1          return wled_flag;
 343   1      }
