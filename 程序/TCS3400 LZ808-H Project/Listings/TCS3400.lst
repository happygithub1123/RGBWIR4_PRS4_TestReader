  10          
  11          
  12          /*------------------------------------------------
  13           * 内部基础 I2C 写 1 字节
  14           *
  15           * @param reg  TCS3400 寄存器地址（例如 0x80/0x81/0x94...）
  16           * @param val  要写入寄存器的数据
  17           *------------------------------------------------*/
  18          static void TCS_Write8(uint8 reg, uint8 val)
  19          {
  20   1          I2C_WriteReg(TCS3400_I2C_ADDR_7BIT, reg, val);
  21   1      }
  22          
  23          
  24          /*------------------------------------------------
  25           * 内部基础 I2C 读 1 字节
  26           *
  27           * @param reg  寄存器地址
  28           * @return     读出的 8 位寄存器值
  29           *------------------------------------------------*/
  30          static uint8 TCS_Read8(uint8 reg)
  31          {
  32   1          return I2C_ReadReg(TCS3400_I2C_ADDR_7BIT, reg);
  33   1      }
  34          
  35          
  36          /*------------------------------------------------
  37           * 内部基础 I2C 读 16 位（低字节 + 高字节）
  38           *
  39           * @param reg_low  低字节寄存器地址（必须是偶地址，如 0x94/0x96...）
  40           * @return         16 位数据
  41           *------------------------------------------------*/
  42          static uint16 TCS_Read16(uint8 reg_low)
  43          {
  44   1          uint8 low, high;
  45   1      
  46   1          low  = TCS_Read8(reg_low);
  47   1          high = TCS_Read8(reg_low + 1);
  48   1      
  49   1          return ((uint16)high << 8) | low;
  50   1      }
