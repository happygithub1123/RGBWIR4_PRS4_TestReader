 197          /*------------------------------------------------
 198           * @brief 读取 IR（通过 0xC0 bit7 切换到 IR，再读 Clear）
 199           *------------------------------------------------*/
 200          /*------------------------------------------------
 201           * @brief 读取 IR（通过 0xC0 bit7 切换到 IR，再读 Clear）
 202           *------------------------------------------------*/
 203          uint16 TCS3400_ReadIR(void)
 204          {
 205   1          uint16 xdata ir;  // ← 加 xdata 关键字，放到外部RAM
 206   1      
 207   1          /* 切到 IR */
 208   1          TCS_Write8(TCS3400_IR, TCS3400_IR_ENABLE);
 209   1      
 210   1          /* 等一帧积分完成（否则读到旧数据） */
 211   1          TCS3400_WaitValid();
 212   1      
 213   1          /* 从 Clear 口读 IR */
 214   1          ir = TCS_Read16(TCS3400_CDATAL);
 215   1      
 216   1          /* 切回正常 Clear */
 217   1          TCS_Write8(TCS3400_IR, TCS3400_IR_DISABLE);
 218   1      
 219   1          /* 建议再等一次（保证下一次读RGB是新数据） */
 220   1          TCS3400_WaitValid();
 221   1      
 222   1          return ir;
 223   1      }
