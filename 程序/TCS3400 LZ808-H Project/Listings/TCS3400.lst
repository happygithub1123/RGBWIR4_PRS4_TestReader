 413           *   r=800 g=780 b=790  → 返回 0（白光）
 414           *------------------------------------------------*/
 415          static bit Is_Blue(uint16 r, uint16 g, uint16 b)
 416          {
 417   1          return (b > r * COLOR_RATIO) && (b > g * COLOR_RATIO);
 418   1      }
