 259          /*------------------------------------------------
 260           * @brief 判断白色
 261           *------------------------------------------------*/
 262          
 263          /* 白色判断（普通白色/白纸/白背景） */
 264          static bit Is_White(uint16 r, uint16 g, uint16 b, uint16 c)
 265          {
 266   1          if (c < C_DARK_TH) return 0;
 267   1      
 268   1          if (r < WHITE_MIN_RGB || g < WHITE_MIN_RGB || b < WHITE_MIN_RGB)
 269   1              return 0;
 270   1      
 271   1          if ((r > g ? r - g : g - r) > WHITE_DIFF_MAX) return 0;
 272   1          if ((r > b ? r - b : b - r) > WHITE_DIFF_MAX) return 0;
 273   1          if ((g > b ? g - b : b - g) > WHITE_DIFF_MAX) return 0;
 274   1      
 275   1          return 1;
 276   1      }
 277          /* 更强的白光LED判断（仍然返回 WHITE，不新增枚举） */
 278          static bit Is_WhiteLED(uint16 r, uint16 g, uint16 b, uint16 c)
 279          {
 280   1          /* 白色LED一般整体更亮 */
 281   1          if (c < 800) return 0;
 282   1      
 283   1          /* RGB 都要够亮 */
 284   1          if (r < 700 || g < 700 || b < 700) return 0;
 285   1      
 286   1          /* RGB 要接近（白光特征） */
 287   1          if ((r > g ? r - g : g - r) > 250) return 0;
 288   1          if ((r > b ? r - b : b - r) > 250) return 0;
 289   1          if ((g > b ? g - b : b - g) > 250) return 0;
 290   1      
 291   1          return 1;
 292   1      }
