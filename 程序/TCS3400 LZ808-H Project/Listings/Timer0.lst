   1          #include "Timer0.h"
   2          
   3          /* P5.4 运行指示灯计数器，单位ms */
   4          static uint16 g_run_led_ms = 0;
   5          
   6          /* 系统节拍计数器，供App层等待和后台采样使用 */
   7          static volatile uint32 g_system_ms = 0;
   8          
   9          void TM0_Init(void)
  10          {
  11   1          /* P5.4 初始化为推挽输出，驱动运行指示灯 */
  12   1          P54 = 0;
  13   1          P5M1 &= ~0x10;
  14   1          P5M0 |= 0x10;
  15   1      
  16   1          /* Timer0 使用 1T 模式16位自动重装*/
  17   1          AUXR |= 0x80;
  18   1          TMOD &= 0xF0;
  19   1      
  20   1          /*
  21   1           * 内部 22.1184MHz,1T模式下，1ms约22118计数脉冲     * 重装值 = 65536 - 22118 = 0xA99A   
             -  */
  22   1          TH0 = 0xA9;
  23   1          TL0 = 0x9A;
  24   1      
  25   1          /* 清零溢出标志，开启Timer0中断，启动Timer0 */
  26   1          TF0 = 0;
  27   1          ET0 = 1;
  28   1          TR0 = 1;
  29   1      }
  30          
  31          uint32 Timer0_GetMs(void)
  32          {
  33   1          uint32 now;
  34   1          bit old_ea;
  35   1      
  36   1          /* 读取32位系统运行毫秒数时关中断，防止中断中途修改*/
  37   1          old_ea = EA;
  38   1          EA = 0;
  39   1          now = g_system_ms;
  40   1          EA = old_ea;
  41   1      
  42   1          return now;
  43   1      }
  44          
  45          void TM0_Isr(void) interrupt 1
  46          {
  47   1          /* 每次中断累加1ms系统节拍*/
