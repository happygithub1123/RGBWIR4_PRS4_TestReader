 116          /*------------------------------------------------
 117           * @brief I2C 发送 1 个字节
 118           * @param dat 要发送的数据
 119           *------------------------------------------------*/
 120          void VEML6040_I2C_SendByte(unsigned char dat)
 121          {
 122   1          unsigned char i;
 123   1      
 124   1          for (i = 0; i < 8; i++)
 125   1          {
 126   2              // 发送最高位（MSB first）
 127   2              VEML6040_SDA = (dat & 0x80) ? 1 : 0;
 128   2              VEML6040_I2C_DelayN(VEML6040_T_SU_DAT);      // 数据建立时间 tSU;DAT
 129   2      
 130   2              VEML6040_SCL = 1;          // VEML6040_SCL 上升沿，数据被采样
 131   2              VEML6040_I2C_DelayN(VEML6040_T_HIGH);       // 时钟高电平 tHIGH
 132   2      
 133   2              VEML6040_SCL = 0;          // VEML6040_SCL 下降沿
 134   2              VEML6040_I2C_DelayN(VEML6040_T_LOW);      // 时钟低电平 tLOW
 135   2      
 136   2              dat <<= 1;        // 左移，准备下一位
 137   2          }
 138   1      }
 139          
 140          /*------------------------------------------------
 141           * @brief I2C 接收 1 个字节
 142           * @return 接收到的数据
 143           *------------------------------------------------*/
 144          unsigned char VEML6040_I2C_ReadByte(void)
 145          {
 146   1          unsigned char i, dat = 0;
 147   1      
 148   1          VEML6040_SDA = 1;                 // 释放 VEML6040_SDA，由从机驱动
 149   1      
 150   1          for (i = 0; i < 8; i++)
 151   1          {
 152   2              VEML6040_SCL = 0;             // VEML6040_SCL 低电平阶段
 153   2              VEML6040_I2C_DelayN(VEML6040_T_LOW);
 154   2      
 155   2              VEML6040_SCL = 1;             // VEML6040_SCL 高电平阶段
 156   2              VEML6040_I2C_DelayN(VEML6040_T_HIGH/2);
 157   2      
 158   2              dat <<= 1;           // MSB first
 159   2              if (VEML6040_SDA) dat |= 0x01;// 采样 VEML6040_SDA
 160   2      
 161   2              VEML6040_I2C_DelayN(VEML6040_T_HIGH - VEML6040_T_HIGH/2);
 162   2          }
 163   1      
 164   1          VEML6040_SCL = 0;                 // 收尾：拉低 VEML6040_SCL
 165   1          VEML6040_I2C_DelayN(VEML6040_T_LOW);
 166   1      
 167   1          return dat;
 168   1      }
