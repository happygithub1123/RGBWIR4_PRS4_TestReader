 686   4                      App_SendErr();
 687   4                      index = 0; overflow = 0; format_error = 0;
 688   4                      continue;
 689   4                  }
 690   3      
 691   3                  if (format_error || overflow || index == 0)
 692   3                      App_SendErr();
 693   3                  else
 694   3                  {
 695   4                      line[index] = 0;
 696   4                      TCS3400_App_ProcessLine(line);
 697   4                  }
 698   3      
 699   3                  index = 0; overflow = 0; got_cr = 0; format_error = 0;
 700   3                  continue;
