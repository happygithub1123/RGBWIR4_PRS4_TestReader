 216          /**
 217           * @brief 发送 IEEE 754 单精度浮点数二进制响应帧
 218           * @param[in] bits IEEE 754 单精度浮点 32 位位模式
 219           * @note 帧格式为 '=' + 4 字节小端浮点数 + CRLF。
 220           */
 221          static void App_SendFloatBits(uint32 bits)
 222          {
 223   1          Uart_SendByte('=');
 224   1          Uart_SendByte((uint8)(bits & 0xFF));
 225   1          Uart_SendByte((uint8)((bits >> 8) & 0xFF));
 226   1          Uart_SendByte((uint8)((bits >> 16) & 0xFF));
 227   1          Uart_SendByte((uint8)((bits >> 24) & 0xFF));
 228   1          Uart_SendStr("\r\n");
 229   1      }
 230          
