 178           * @brief 将 16 位无符号整数转换为 IEEE 754 单精度浮点位模式
 179           * @param[in] value 待转换的 16 位无符号整数
 180           * @return 数值等价的 IEEE 754 单精度浮点 32 位位模式
 181           * @note 输入范围为 0~65535，可被单精度浮点精确表示。
 182           */
 183          static uint32 App_U16ToFloatBits(uint16 value)
 184          {
 185   1          uint8 exp;
 186   1          uint16 base;
 187   1          uint16 rest;
 188   1          uint32 bits;
 189   1      
 190   1          if (value == 0)
 191   1          {
 192   2              return 0;
 193   2          }
 194   1      
 195   1          exp = 0;
 196   1          base = 1;
 197   1      
 198   1          while ((base <= 0x4000) &&
 199   1                 ((uint16)(base << 1) <= value))
 200   1          {
 201   2              base <<= 1;
 202   2              exp++;
 203   2          }
 204   1      
 205   1          rest = value - base;
 206   1      
 207   1          /* 组合指数部分 */
 208   1          bits = ((uint32)(exp + 127) << 23);
 209   1      
 210   1          /* 组合尾数部分 */
 211   1          bits |= ((uint32)rest << (23 - exp));
 212   1      
 213   1          return bits;
 214   1      }
