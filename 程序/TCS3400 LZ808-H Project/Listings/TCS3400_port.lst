   5          /*------------------------------------------------
   6           * @brief 通过串口打印颜色识别结果字符串
   7           *
   8           * @param color 颜色识别结果枚举值（Color_t）
   9           *
  10           * 示例：
  11           *   Uart_PrintColor(COLOR_WHITE);  // 输出 "WHITE"
  12           *   Uart_PrintColor(COLOR_RED);    // 输出 "RED"
  13           *------------------------------------------------*/
  14          void Uart_PrintColor(Color_t color)
  15          {
  16   1          switch (color)
  17   1          {
  18   2              case COLOR_BLACK:  Uart_SendStr("BLACK");     break;
  19   2              case COLOR_WHITE:  Uart_SendStr("WHITE");     break;  // ← 恢复这行
  20   2              case COLOR_WLED:   Uart_SendStr("WHITE_LED"); break;
  21   2              case COLOR_RED:    Uart_SendStr("RED");       break;
  22   2              case COLOR_GREEN:  Uart_SendStr("GREEN");     break;
  23   2              case COLOR_BLUE:   Uart_SendStr("BLUE");      break;
  24   2              default:           Uart_SendStr("UNKNOWN");   break;
  25   2          }
  26   1      }
  27          
