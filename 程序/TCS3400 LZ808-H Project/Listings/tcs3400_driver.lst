 704   1      
 705   1          if (!read_ok)
 706   1          {
 707   2              return 0;
 708   2          }
 709   1      
 710   1          /* 等待关闭 IR 映射后的普通模式恢复 */
 711   1          if (!TCS3400_WaitValid(bus))
 712   1          {
 713   2              return 0;
 714   2          }
 715   1      
 716   1          return 1;
 717   1      }       
